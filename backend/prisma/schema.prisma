// AS ONE — Prisma Schema
// Version 1.0 — Aligné sur le Cahier des Charges v6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  COMPTABLE
  CHEF
  MAGASINIER
  AGENT
}

enum AgentType {
  TEMPORAIRE
  PERMANENT
}

enum SiteType {
  CHANTIER
  PERMANENCE
}

enum AssignmentStatus {
  PENDING_CONFIRMATION // agent doit confirmer / peut refuser jusqu'à 22h
  CONFIRMED
  REFUSED
  LOCKED               // chantier multi-jours en cours
  COMPLETED
  CANCELLED
}

enum PointageType {
  ARRIVEE
  DEPART
  PRESENCE_PERMANENCE  // liste de présence (optionnelle photo)
}

enum MaterialState {
  BON
  DEGRADE
  MANQUANT
}

enum RetentionTarget {
  ONE_AGENT
  WHOLE_GROUP
}

enum PayrollStatus {
  DRAFT
  SIMULATION
  VALIDATED
  PAID
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Agent specific
  agentType     AgentType?
  mobileMoneyOperator String?  // détecté auto
  rankingScore  Float     @default(0) // moyenne des notes

  // Relations
  agentProfile  AgentProfile?
  chefSites     SiteChef[]
  assignments   Assignment[]  @relation("AgentAssignments")
  createdAssignments Assignment[] @relation("CreatedByChef")
  transferRequestsFrom TransferRequest[] @relation("FromChef")
  transferRequestsTo   TransferRequest[] @relation("ToChef")
  pointages     Pointage[]
  ratingsGiven  Rating[]      @relation("RatedBy")
  ratingsReceived Rating[]    @relation("RatedAgent")
  materialRetentions MaterialRetention[]
  payrollLines  PayrollLine[]
  auditLogs     AuditLog[]

  @@index([role, isActive])
  incidentsReported Incident[]
  siteTasksCreated  SiteTask[]
  siteReportsCreated SiteReport[]

  @@index([phone])
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isAvailable     Boolean  @default(true) // gros bouton
  availableUntil  DateTime? // null = continue
  lastAvailabilityChange DateTime @default(now())

  // Historique simple des disponibilités (optionnel pour audit léger)
  availabilityLogs AvailabilityLog[]
}

model AvailabilityLog {
  id        String   @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  isAvailable Boolean
  changedAt DateTime @default(now())
}

// ============================================================
// SITES (Chantiers & Permanences)
// ============================================================

model Site {
  id          String    @id @default(cuid())
  name        String
  type        SiteType
  address     String?
  location    String?   // GPS ou description
  startDate   DateTime?
  endDate     DateTime? // null = permanence ouverte
  isActive    Boolean   @default(true)

  // Tarification
  dailyRate         Decimal? @db.Decimal(10, 2)
  exceptionalRate   Decimal? @db.Decimal(10, 2)
  bonusAmount       Decimal? @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  chefs       SiteChef[]
  assignments Assignment[]
  materials   MaterialMovement[]
  pointages   Pointage[]
  incidents   Incident[]
  siteTasks   SiteTask[]
  reports     SiteReport[]
}

model SiteChef {
  id        String @id @default(cuid())
  siteId    String
  chefId    String
  site      Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  chef      User   @relation(fields: [chefId], references: [id], onDelete: Cascade)

  @@unique([siteId, chefId])
}

// ============================================================
// ASSIGNMENTS (Attribution d'équipe)
// ============================================================

model Assignment {
  id          String           @id @default(cuid())
  siteId      String
  agentId     String
  createdById String           // chef qui a créé
  status      AssignmentStatus @default(PENDING_CONFIRMATION)

  startDate   DateTime
  endDate     DateTime?        // null si permanence ou multi-jours en cours
  isLocked    Boolean          @default(false) // reste verrouillé jusqu'à fin chantier

  confirmedAt DateTime?
  refusedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  site        Site             @relation(fields: [siteId], references: [id])
  agent       User             @relation("AgentAssignments", fields: [agentId], references: [id])
  createdBy   User             @relation("CreatedByChef", fields: [createdById], references: [id])

  transferRequests TransferRequest[]
  pointages   Pointage[]
  ratings     Rating[]

  @@index([agentId, status])
  @@index([siteId, startDate])
  @@index([status, isLocked])
}

model TransferRequest {
  id              String   @id @default(cuid())
  assignmentId    String
  fromChefId      String
  toChefId        String
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  fromChef        User       @relation("FromChef", fields: [fromChefId], references: [id])
  toChef          User       @relation("ToChef", fields: [toChefId], references: [id])
}

// ============================================================
// POINTAGE
// ============================================================

model Pointage {
  id            String       @id @default(cuid())
  assignmentId  String?
  siteId        String
  agentId       String
  type          PointageType
  photoUrl      String?      // optionnel
  latitude      Float?
  longitude     Float?
  notedAt       DateTime     @default(now())
  createdById   String?      // chef qui a pointé

  assignment    Assignment?  @relation(fields: [assignmentId], references: [id])
  site          Site         @relation(fields: [siteId], references: [id])
  agent         User         @relation(fields: [agentId], references: [id])

  @@index([agentId, notedAt])
  @@index([siteId, notedAt])
}

// ============================================================
// NOTATION & CLASSEMENT
// ============================================================

model Rating {
  id            String   @id @default(cuid())
  assignmentId  String
  agentId       String
  ratedById     String   // chef
  score         Int      // 1 à 5
  comment       String?
  createdAt     DateTime @default(now())

  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  agent         User       @relation("RatedAgent", fields: [agentId], references: [id])
  ratedBy       User       @relation("RatedBy", fields: [ratedById], references: [id])

  @@unique([assignmentId, agentId])
}

// ============================================================
// MATÉRIEL
// ============================================================

model MaterialItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // consignable | consommable
  unitPrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  movements   MaterialMovement[]
}

model MaterialMovement {
  id            String         @id @default(cuid())
  siteId        String
  itemId        String
  quantity      Int
  type          String         // OUT | RETURN
  state         MaterialState? // uniquement sur RETURN
  notes         String?
  createdById   String         // magasinier
  createdAt     DateTime       @default(now())
  printableRef  String?        // référence imprimable

  site          Site           @relation(fields: [siteId], references: [id])
  item          MaterialItem   @relation(fields: [itemId], references: [id])
  retention     MaterialRetention?
}

model MaterialRetention {
  id              String          @id @default(cuid())
  movementId      String          @unique
  target          RetentionTarget
  agentId         String?         // si ONE_AGENT
  amount          Decimal         @db.Decimal(10, 2) // montant total ou part
  isApplied       Boolean         @default(true) // créé immédiatement
  createdAt       DateTime        @default(now())

  movement        MaterialMovement @relation(fields: [movementId], references: [id])
  agent           User?            @relation(fields: [agentId], references: [id])
}

// ============================================================
// INCIDENTS
// ============================================================

model Incident {
  id           String   @id @default(cuid())
  siteId       String
  reportedById String
  description  String
  photoUrl     String?
  /// DEGAT | MATERIEL | SECURITE | AUTRE
  type         String   @default("AUTRE")
  /// BASSE | MOYENNE | HAUTE
  severity     String   @default("MOYENNE")
  status       String   @default("OUVERT") // OUVERT | EN_COURS | RESOLU
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  site         Site     @relation(fields: [siteId], references: [id])
  reportedBy   User     @relation(fields: [reportedById], references: [id])
}


// ============================================================
// TÂCHES & RAPPORT FIN DE CHANTIER
// ============================================================

model SiteTask {
  id          String   @id @default(cuid())
  siteId      String
  description String
  /// Date réelle d'exécution de la tâche
  performedAt DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([siteId, performedAt])
}

model SiteReport {
  id          String   @id @default(cuid())
  siteId      String
  startDate   DateTime
  endDate     DateTime
  /// Résumé libre du chef
  summary     String?
  /// Snapshot JSON : tâches, équipe, pointages, matériel, incidents
  details     Json
  status      String   @default("FINAL") // DRAFT | FINAL
  createdById String
  closedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([siteId])
}

// ============================================================
// PAIE
// ============================================================

model PayrollPeriod {
  id          String        @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  status      PayrollStatus @default(DRAFT)
  createdById String
  validatedAt DateTime?
  createdAt   DateTime      @default(now())

  lines       PayrollLine[]
}

model PayrollLine {
  id              String   @id @default(cuid())
  periodId        String
  agentId         String
  baseAmount      Decimal  @db.Decimal(12, 2)
  primes          Decimal  @db.Decimal(12, 2) @default(0)
  retenues        Decimal  @db.Decimal(12, 2) @default(0)
  netAmount       Decimal  @db.Decimal(12, 2)
  details         Json?    // détail des calculs
  createdAt       DateTime @default(now())

  period          PayrollPeriod @relation(fields: [periodId], references: [id])
  agent           User          @relation(fields: [agentId], references: [id])

  @@index([agentId, periodId])
}

// ============================================================
// ALERTES VÉHICULES & AUTRES
// ============================================================

model VehicleAlert {
  id            String   @id @default(cuid())
  vehicleName   String
  alertType     String   // ASSURANCE | VIDANGE | OTHER
  lastDate      DateTime
  validityDays  Int
  nextDueDate   DateTime
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}
