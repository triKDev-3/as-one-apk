// AS ONE — Prisma Schema
// Version 1.1 — Pointage départ + absent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPTABLE
  CHEF
  MAGASINIER
  AGENT
}

enum AgentType {
  TEMPORAIRE
  PERMANENT
}

enum SiteType {
  CHANTIER
  PERMANENCE
  ROUTINE
}

enum AssignmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REFUSED
  LOCKED
  COMPLETED
  CANCELLED
}

enum PointageType {
  ARRIVEE
  DEPART
  PRESENCE_PERMANENCE
  ABSENT
}

enum MaterialState {
  BON
  DEGRADE
  MANQUANT
}

enum RetentionTarget {
  ONE_AGENT
  WHOLE_GROUP
}

enum PayrollStatus {
  DRAFT
  SIMULATION
  VALIDATED
  PAID
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  contractType  String    @default("TEMPORAIRE")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  agentType     AgentType?
  mobileMoneyOperator String?
  rankingScore  Float     @default(0)
  agentProfile  AgentProfile?
  chefSites     SiteChef[]
  assignments   Assignment[]  @relation("AgentAssignments")
  createdAssignments Assignment[] @relation("CreatedByChef")
  transferRequestsFrom TransferRequest[] @relation("FromChef")
  transferRequestsTo   TransferRequest[] @relation("ToChef")
  pointages     Pointage[]
  ratingsGiven  Rating[]      @relation("RatedBy")
  ratingsReceived Rating[]    @relation("RatedAgent")
  materialRetentions MaterialRetention[]
  incidentPenalties IncidentPenalty[] @relation("PenaltyAgent")
  penaltiesApplied IncidentPenalty[] @relation("PenaltyAppliedBy")
  payrollLines  PayrollLine[]
  auditLogs     AuditLog[]
  incidentsReported Incident[]
  siteTasksCreated  SiteTask[]
  siteReportsCreated SiteReport[]
  @@index([role, isActive])
  @@index([phone])
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAvailable     Boolean  @default(true)
  availableUntil  DateTime?
  lastAvailabilityChange DateTime @default(now())
  paidMonths      Json?
  unavailableDates Json?
  availabilityLogs AvailabilityLog[]
}

model AvailabilityLog {
  id        String   @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  isAvailable Boolean
  changedAt DateTime @default(now())
}

model Site {
  id          String    @id @default(cuid())
  name        String
  type        SiteType
  address     String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  dailyRate         Decimal? @db.Decimal(10, 2)
  nightRate         Decimal? @db.Decimal(10, 2) @default(4500)
  sundayRate        Decimal? @db.Decimal(10, 2) @default(5000)
  bonusAmount       Decimal? @db.Decimal(10, 2)
  monthlySalary     Decimal? @db.Decimal(10, 2)
  fixedAmount       Decimal? @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  chefs       SiteChef[]
  assignments Assignment[]
  materials   MaterialMovement[]
  pointages   Pointage[]
  incidents   Incident[]
  siteTasks   SiteTask[]
  reports     SiteReport[]
}

model SiteChef {
  id        String @id @default(cuid())
  siteId    String
  chefId    String
  site      Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  chef      User   @relation(fields: [chefId], references: [id], onDelete: Cascade)
  @@unique([siteId, chefId])
}

