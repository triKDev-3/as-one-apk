model TransferRequest {
  id              String   @id @default(cuid())
  assignmentId    String
  fromChefId      String
  toChefId        String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  fromChef        User       @relation("FromChef", fields: [fromChefId], references: [id])
  toChef          User       @relation("ToChef", fields: [toChefId], references: [id])
}

model Pointage {
  id            String       @id @default(cuid())
  assignmentId  String?
  siteId        String
  agentId       String
  type          PointageType
  photoUrl      String?
  latitude      Float?
  longitude     Float?
  notedAt       DateTime     @default(now())
  createdById   String?
  assignment    Assignment?  @relation(fields: [assignmentId], references: [id])
  site          Site         @relation(fields: [siteId], references: [id])
  agent         User         @relation(fields: [agentId], references: [id])
  @@index([agentId, notedAt])
  @@index([siteId, notedAt])
}

model Rating {
  id            String   @id @default(cuid())
  assignmentId  String
  agentId       String
  ratedById     String
  score         Int
  comment       String?
  createdAt     DateTime @default(now())
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  agent         User       @relation("RatedAgent", fields: [agentId], references: [id])
  ratedBy       User       @relation("RatedBy", fields: [ratedById], references: [id])
  @@index([assignmentId])
  @@index([assignmentId, agentId])
}

model MaterialItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  unitPrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  movements   MaterialMovement[]
}

model MaterialMovement {
  id            String         @id @default(cuid())
  siteId        String
  itemId        String
  quantity      Int
  type          String
  state         MaterialState?
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  printableRef  String?
  site          Site           @relation(fields: [siteId], references: [id])
  item          MaterialItem   @relation(fields: [itemId], references: [id])
  retention     MaterialRetention?
}

model MaterialRetention {
  id              String          @id @default(cuid())
  movementId      String          @unique
  target          RetentionTarget
  agentId         String?
  amount          Decimal         @db.Decimal(10, 2)
  isApplied       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  movement        MaterialMovement @relation(fields: [movementId], references: [id])
  agent           User?            @relation(fields: [agentId], references: [id])
}

model Incident {
  id           String   @id @default(cuid())
  siteId       String
  reportedById String
  description  String
  photoUrl     String?
  type         String   @default("AUTRE")
  severity     String   @default("MOYENNE")
  status       String   @default("OUVERT")
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  site         Site     @relation(fields: [siteId], references: [id])
  reportedBy   User     @relation(fields: [reportedById], references: [id])
  penalties    IncidentPenalty[]
}

model IncidentPenalty {
  id          String   @id @default(cuid())
  incidentId  String
  agentId     String?
  target      RetentionTarget
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  appliedById String
  createdAt   DateTime @default(now())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agent       User?    @relation("PenaltyAgent", fields: [agentId], references: [id])
  appliedBy   User     @relation("PenaltyAppliedBy", fields: [appliedById], references: [id])
  @@index([agentId, createdAt])
  @@index([incidentId])
}

model SiteTask {
  id          String   @id @default(cuid())
  siteId      String
  description String
  performedAt DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  @@index([siteId, performedAt])
}

model SiteReport {
  id          String   @id @default(cuid())
  siteId      String
  startDate   DateTime
  endDate     DateTime
  summary     String?
  details     Json
  status      String   @default("FINAL")
  createdById String
  closedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  @@index([siteId])
}

model PayrollPeriod {
  id          String        @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  status      PayrollStatus @default(DRAFT)
  createdById String
  validatedAt DateTime?
  createdAt   DateTime      @default(now())
  lines       PayrollLine[]
}

model PayrollLine {
  id              String   @id @default(cuid())
  periodId        String
  agentId         String
  baseAmount      Decimal  @db.Decimal(12, 2)
  primes          Decimal  @db.Decimal(12, 2) @default(0)
  retenues        Decimal  @db.Decimal(12, 2) @default(0)
  netAmount       Decimal  @db.Decimal(12, 2)
  details         Json?
  createdAt       DateTime @default(now())
  period          PayrollPeriod @relation(fields: [periodId], references: [id])
  agent           User          @relation(fields: [agentId], references: [id])
  @@index([agentId, periodId])
}

model VehicleAlert {
  id            String   @id @default(cuid())
  vehicleName   String
  alertType     String
  lastDate      DateTime
  validityDays  Int
  nextDueDate   DateTime
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}
